{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icarus.local/schemas/provider-health.v2.schema.json",
  "title": "ICARUS four-route provider health report with optional local inference probes",
  "type": "object",
  "required": [
    "schema",
    "status",
    "checks",
    "routes",
    "chat_completions_probe"
  ],
  "properties": {
    "schema": {
      "const": "icarus.provider-health.v2"
    },
    "status": {
      "enum": [
        "ok",
        "warning",
        "error"
      ]
    },
    "chat_completions_probe": {
      "enum": [
        "skipped",
        "passed",
        "partial",
        "failed"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "routes": {
      "type": "object",
      "properties": {
        "system1_local": {
          "$ref": "#/$defs/route"
        },
        "system1_api": {
          "$ref": "#/$defs/route"
        },
        "system2_local": {
          "$ref": "#/$defs/route"
        },
        "system2_api": {
          "$ref": "#/$defs/route"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "required": [
        "name",
        "status",
        "message"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "ok",
            "warning",
            "error",
            "skipped"
          ]
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "route": {
      "type": "object",
      "required": [
        "enabled",
        "kind",
        "model",
        "status",
        "checks",
        "inference_probe"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "kind": {
          "enum": [
            "local",
            "api"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "ok",
            "warning",
            "error",
            "skipped"
          ]
        },
        "endpoint": {
          "type": "string"
        },
        "credential_source": {
          "enum": [
            "environment",
            "local_default"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "inference_probe": {
          "type": "object",
          "required": [
            "status",
            "message"
          ],
          "properties": {
            "status": {
              "enum": [
                "skipped",
                "passed",
                "failed"
              ]
            },
            "message": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
