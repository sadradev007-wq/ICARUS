{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "icarus.taxonomy.v1",
  "type": "object",
  "required": [
    "schema",
    "locale",
    "categories"
  ],
  "properties": {
    "schema": {
      "const": "icarus.taxonomy.v1"
    },
    "locale": {
      "type": "string"
    },
    "categories": {
      "type": "array",
      "minItems": 50,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "children"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "children": {
            "type": "array",
            "minItems": 20,
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "id",
                "title"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
