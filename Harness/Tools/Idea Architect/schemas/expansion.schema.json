{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icarus.local/schemas/itp-1.0/expansion.schema.json",
  "title": "ICARUS ITP-1.0 System 2 Expansion",
  "type": "object",
  "required": ["protocol", "model_role", "parent_task", "subtasks", "decomposition_complete"],
  "properties": {
    "protocol": {"const": "ITP-1.0"},
    "model_role": {"const": "system2"},
    "parent_task": {"type": "string", "minLength": 1},
    "analysis": {"type": "object"},
    "decomposition_complete": {"type": "boolean"},
    "subtasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "description", "priority", "status", "method", "inputs", "expected_outputs", "acceptance_criteria"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "description": {"type": "string"},
          "priority": {"enum": ["low", "normal", "high", "critical"]},
          "status": {"enum": ["pending", "ready", "blocked", "running", "completed", "failed", "cancelled"]},
          "method": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "inputs": {"type": "array", "minItems": 1},
          "expected_outputs": {"type": "array", "minItems": 1},
          "acceptance_criteria": {"type": "array", "minItems": 1},
          "required_skills": {"type": "array", "items": {"type": "string"}},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "risks": {"type": "array"},
          "permissions": {"type": "object"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
