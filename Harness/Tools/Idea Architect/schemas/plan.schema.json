{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icarus.local/schemas/itp-1.0/plan.schema.json",
  "title": "ICARUS ITP-1.0 Plan",
  "type": "object",
  "required": ["protocol", "project_id", "model_role", "objective", "tasks", "completion_criteria"],
  "properties": {
    "protocol": {"const": "ITP-1.0"},
    "project_id": {"type": "string", "minLength": 1},
    "model_role": {"const": "system1"},
    "objective": {"type": "string", "minLength": 1},
    "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}},
    "completion_criteria": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": ["id", "title", "description", "priority", "status", "children"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "priority": {"enum": ["low", "normal", "high", "critical"]},
        "status": {"enum": ["pending", "ready", "blocked", "running", "completed", "failed", "cancelled"]},
        "children": {"type": "array", "items": {"$ref": "#/$defs/task"}},
        "dependencies": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
