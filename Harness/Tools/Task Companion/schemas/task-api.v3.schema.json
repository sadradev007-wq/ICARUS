{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icarus.local/schemas/task-api.v3.schema.json",
  "title": "ICARUS Task Companion read-only API v3 response",
  "description": "Public read-only snapshot with privacy-bounded Coding Harness run history; v1 and v2 remain unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "tasks",
    "pending_execution_events",
    "counts",
    "task_run_history"
  ],
  "properties": {
    "schema": {
      "const": "icarus.task-api.v3"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "priority",
          "status",
          "due_at",
          "project_id",
          "parent_id",
          "tags",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "critical",
              "high",
              "normal",
              "low"
            ]
          },
          "status": {
            "enum": [
              "inbox",
              "next",
              "in_progress",
              "waiting"
            ]
          },
          "due_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "project_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "pending_execution_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "task_id",
          "run_status",
          "proposed_status",
          "summary",
          "created_at"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^E-[a-f0-9]{32}$"
          },
          "task_id": {
            "type": "string",
            "minLength": 3
          },
          "run_status": {
            "enum": [
              "completed",
              "step_limit"
            ]
          },
          "proposed_status": {
            "enum": [
              "completed",
              "in_progress"
            ]
          },
          "summary": {
            "type": "string",
            "maxLength": 1000
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "run_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "description": "Optional stable Coding Harness run ID; absent for legacy events."
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_tasks",
        "critical_or_high_tasks",
        "pending_execution_events",
        "task_run_records"
      ],
      "properties": {
        "active_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "critical_or_high_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "pending_execution_events": {
          "type": "integer",
          "minimum": 0
        },
        "task_run_records": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "task_run_history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "by_task"
      ],
      "properties": {
        "status": {
          "enum": [
            "configured",
            "not_configured"
          ]
        },
        "by_task": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_id",
              "runs"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "runs": {
                "type": "array",
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "record_id",
                    "run_id",
                    "created_at",
                    "status",
                    "steps",
                    "verification"
                  ],
                  "properties": {
                    "record_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "run_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^[a-f0-9]{32}$"
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time",
                      "maxLength": 64
                    },
                    "status": {
                      "enum": [
                        "completed",
                        "step_limit",
                        "error"
                      ]
                    },
                    "steps": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "verification": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "tests_reported",
                        "review_status"
                      ],
                      "properties": {
                        "tests_reported": {
                          "type": "boolean"
                        },
                        "review_status": {
                          "enum": [
                            "completed",
                            "no_changes",
                            "required",
                            "unavailable",
                            "invalid_or_unknown",
                            "static_diff_reviewed"
                          ]
                        },
                        "ci_status": {
                          "enum": [
                            "passed",
                            "passed_for_idea_architect"
                          ]
                        },
                        "tested_commit": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{40}$"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
