{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icarus.local/schemas/task-api.v5.schema.json",
  "title": "ICARUS Task Companion read-only API v5 response",
  "description": "Version 4 read-only task, run, and action projections plus a unified, privacy-bounded execution timeline. v1-v4 remain unchanged.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generated_at",
    "tasks",
    "pending_execution_events",
    "counts",
    "task_run_history",
    "action_history",
    "execution_timeline"
  ],
  "properties": {
    "schema": {
      "const": "icarus.task-api.v5"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "description",
          "priority",
          "status",
          "due_at",
          "project_id",
          "parent_id",
          "tags",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 3
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "priority": {
            "enum": [
              "critical",
              "high",
              "normal",
              "low"
            ]
          },
          "status": {
            "enum": [
              "inbox",
              "next",
              "in_progress",
              "waiting"
            ]
          },
          "due_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "project_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "pending_execution_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "task_id",
          "run_status",
          "proposed_status",
          "summary",
          "created_at"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^E-[a-f0-9]{32}$"
          },
          "task_id": {
            "type": "string",
            "minLength": 3
          },
          "run_status": {
            "enum": [
              "completed",
              "step_limit"
            ]
          },
          "proposed_status": {
            "enum": [
              "completed",
              "in_progress"
            ]
          },
          "summary": {
            "type": "string",
            "maxLength": 1000
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "run_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$",
            "description": "Optional stable Coding Harness run ID; absent for legacy events."
          }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_tasks",
        "critical_or_high_tasks",
        "pending_execution_events",
        "task_run_records",
        "action_journal_events",
        "timeline_entries"
      ],
      "properties": {
        "active_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "critical_or_high_tasks": {
          "type": "integer",
          "minimum": 0
        },
        "pending_execution_events": {
          "type": "integer",
          "minimum": 0
        },
        "task_run_records": {
          "type": "integer",
          "minimum": 0
        },
        "action_journal_events": {
          "type": "integer",
          "minimum": 0
        },
        "timeline_entries": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "task_run_history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "by_task"
      ],
      "properties": {
        "status": {
          "enum": [
            "configured",
            "not_configured"
          ]
        },
        "by_task": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_id",
              "runs"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "runs": {
                "type": "array",
                "maxItems": 5,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "record_id",
                    "run_id",
                    "created_at",
                    "status",
                    "steps",
                    "verification"
                  ],
                  "properties": {
                    "record_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "run_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^[a-f0-9]{32}$"
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time",
                      "maxLength": 64
                    },
                    "status": {
                      "enum": [
                        "completed",
                        "step_limit",
                        "error"
                      ]
                    },
                    "steps": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "verification": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "tests_reported",
                        "review_status"
                      ],
                      "properties": {
                        "tests_reported": {
                          "type": "boolean"
                        },
                        "review_status": {
                          "enum": [
                            "completed",
                            "no_changes",
                            "required",
                            "unavailable",
                            "invalid_or_unknown",
                            "static_diff_reviewed"
                          ]
                        },
                        "ci_status": {
                          "enum": [
                            "passed",
                            "passed_for_idea_architect"
                          ]
                        },
                        "tested_commit": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{40}$"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "action_history": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "by_task"
      ],
      "properties": {
        "status": {
          "enum": [
            "configured",
            "not_configured"
          ]
        },
        "by_task": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_id",
              "events"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "events": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "event_id",
                    "created_at",
                    "event_type",
                    "actor",
                    "outcome_status",
                    "approval_status",
                    "approved_by",
                    "run_id",
                    "proposal_id"
                  ],
                  "properties": {
                    "event_id": {
                      "type": "string",
                      "pattern": "^A-[a-f0-9]{32}$"
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time",
                      "maxLength": 64
                    },
                    "event_type": {
                      "enum": [
                        "user_request",
                        "assistant_decision",
                        "tool_started",
                        "tool_finished",
                        "mutation_proposed",
                        "mutation_applied",
                        "approval_granted",
                        "approval_denied",
                        "checkpoint_created",
                        "rollback_applied",
                        "task_changed",
                        "calendar_changed",
                        "provider_selected",
                        "error",
                        "response_completed"
                      ]
                    },
                    "actor": {
                      "enum": [
                        "user",
                        "assistant",
                        "system",
                        "external_service"
                      ]
                    },
                    "outcome_status": {
                      "enum": [
                        "proposed",
                        "succeeded",
                        "failed",
                        "denied",
                        "cancelled",
                        "skipped"
                      ]
                    },
                    "approval_status": {
                      "enum": [
                        "not_required",
                        "pending",
                        "approved",
                        "denied"
                      ]
                    },
                    "approved_by": {
                      "enum": [
                        "user",
                        "none"
                      ]
                    },
                    "run_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^[a-f0-9]{32}$"
                    },
                    "proposal_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^P-[a-f0-9]{32}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "execution_timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "by_task"
      ],
      "properties": {
        "status": {
          "enum": [
            "configured",
            "partial",
            "not_configured"
          ]
        },
        "by_task": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "task_id",
              "entries"
            ],
            "properties": {
              "task_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "entries": {
                "type": "array",
                "maxItems": 15,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "source",
                    "source_id",
                    "created_at",
                    "event_type",
                    "status",
                    "actor",
                    "run_id",
                    "proposal_id",
                    "steps",
                    "tests_reported",
                    "review_status",
                    "ci_status",
                    "approval_status",
                    "approved_by"
                  ],
                  "properties": {
                    "source": {
                      "enum": [
                        "coding_harness",
                        "action_journal"
                      ]
                    },
                    "source_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "created_at": {
                      "type": "string",
                      "format": "date-time",
                      "maxLength": 64
                    },
                    "event_type": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "actor": {
                      "type": "string"
                    },
                    "run_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^[a-f0-9]{32}$"
                    },
                    "proposal_id": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^P-[a-f0-9]{32}$"
                    },
                    "steps": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 0
                    },
                    "tests_reported": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    },
                    "review_status": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "enum": [
                        "completed",
                        "no_changes",
                        "required",
                        "unavailable",
                        "invalid_or_unknown",
                        "static_diff_reviewed",
                        null
                      ]
                    },
                    "ci_status": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "enum": [
                        "passed",
                        "passed_for_idea_architect",
                        null
                      ]
                    },
                    "approval_status": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "enum": [
                        "not_required",
                        "pending",
                        "approved",
                        "denied",
                        null
                      ]
                    },
                    "approved_by": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "enum": [
                        "user",
                        "none",
                        null
                      ]
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "source": {
                            "const": "coding_harness"
                          }
                        },
                        "required": [
                          "source"
                        ]
                      },
                      "then": {
                        "properties": {
                          "source_id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 128
                          },
                          "event_type": {
                            "const": "task_run"
                          },
                          "status": {
                            "enum": [
                              "completed",
                              "step_limit",
                              "error"
                            ]
                          },
                          "actor": {
                            "const": "harness"
                          },
                          "proposal_id": {
                            "type": "null"
                          },
                          "steps": {
                            "type": "integer",
                            "minimum": 0
                          },
                          "tests_reported": {
                            "type": "boolean"
                          },
                          "review_status": {
                            "enum": [
                              "completed",
                              "no_changes",
                              "required",
                              "unavailable",
                              "invalid_or_unknown",
                              "static_diff_reviewed"
                            ]
                          },
                          "ci_status": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "enum": [
                              "passed",
                              "passed_for_idea_architect",
                              null
                            ]
                          },
                          "approval_status": {
                            "type": "null"
                          },
                          "approved_by": {
                            "type": "null"
                          }
                        }
                      }
                    },
                    {
                      "if": {
                        "properties": {
                          "source": {
                            "const": "action_journal"
                          }
                        },
                        "required": [
                          "source"
                        ]
                      },
                      "then": {
                        "properties": {
                          "source_id": {
                            "type": "string",
                            "pattern": "^A-[a-f0-9]{32}$"
                          },
                          "event_type": {
                            "enum": [
                              "user_request",
                              "assistant_decision",
                              "tool_started",
                              "tool_finished",
                              "mutation_proposed",
                              "mutation_applied",
                              "approval_granted",
                              "approval_denied",
                              "checkpoint_created",
                              "rollback_applied",
                              "task_changed",
                              "calendar_changed",
                              "provider_selected",
                              "error",
                              "response_completed"
                            ]
                          },
                          "status": {
                            "enum": [
                              "proposed",
                              "succeeded",
                              "failed",
                              "denied",
                              "cancelled",
                              "skipped"
                            ]
                          },
                          "actor": {
                            "enum": [
                              "user",
                              "assistant",
                              "system",
                              "external_service"
                            ]
                          },
                          "steps": {
                            "type": "null"
                          },
                          "tests_reported": {
                            "type": "null"
                          },
                          "review_status": {
                            "type": "null"
                          },
                          "ci_status": {
                            "type": "null"
                          },
                          "approval_status": {
                            "enum": [
                              "not_required",
                              "pending",
                              "approved",
                              "denied"
                            ]
                          },
                          "approved_by": {
                            "enum": [
                              "user",
                              "none"
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
